# Auto detect text files and perform LF normalization
* text=auto

# Ensure certain files always use LF line endings
*.ts eol=lf
*.tsx eol=lf
*.js eol=lf
*.jsx eol=lf
*.json eol=lf
*.md eol=lf
*.yml eol=lf
*.yaml eol=lf

# Windows-specific files use CRLF
*.bat eol=crlf
*.cmd eol=crlf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary