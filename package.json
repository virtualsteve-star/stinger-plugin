{
  "name": "stinger-guard",
  "version": "0.1.0-a4",
  "description": "Chrome extension for LLM security guardrails via Stinger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint extension/src --ext .ts,.tsx",
    "format": "prettier --write \"extension/src/**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run typecheck",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:alpha": "node scripts/bump-version.js alpha",
    "version:beta": "node scripts/bump-version.js beta",
    "ci:local": "npm run typecheck && npm run lint && npm run test",
    "format:check": "prettier --check \"extension/src/**/*.{ts,tsx,json,css}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtualsteve-star/stinger-plugin.git"
  },
  "keywords": [
    "chrome-extension",
    "llm",
    "security",
    "chatgpt",
    "stinger"
  ],
  "author": "Stinger Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/virtualsteve-star/stinger-plugin/issues"
  },
  "homepage": "https://github.com/virtualsteve-star/stinger-plugin#readme",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.2",
    "@playwright/test": "^1.54.1",
    "@types/chrome": "^0.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.5.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "playwright": "^1.54.1",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "typescript": "5.8.3",
    "vite": "^7.0.4",
    "whatwg-fetch": "^3.6.20"
  }
}
